{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/main.tsx",
    "src/App.tsx",
    "src/App.css",
    "src/styles-entry.js"
  ]
}
